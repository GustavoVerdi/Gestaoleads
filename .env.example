GOOGLE_MAPS_API_KEY=cole_sua_chave_aqui
PORT=4173
# Supabase Auth: configure no Render/local, nunca use service_role neste app.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_publica
# Apenas no servidor/Render. Nunca exponha esta chave no navegador ou no Git.
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_somente_no_render
# Opcional: serviço local gosom/google-maps-scraper no Docker Desktop.
# Sem essa URL, a busca aberta atual continua usando OpenStreetMap.
# GOOGLE_MAPS_SCRAPER_URL=http://127.0.0.1:8080
# Padrão: fast (sem Chromium; até 21 empresas por consulta, dados reduzidos).
# Use full somente em um servidor com memória suficiente para Chromium.
GOOGLE_MAPS_SCRAPER_MODE=fast
